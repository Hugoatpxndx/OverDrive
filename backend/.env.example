# ============================================================
# Configuración de OverDrive Backend
# Copia este archivo a backend/.env y completa los valores reales:
#   cp backend/.env.example backend/.env
# ============================================================

# Base de datos (MariaDB/MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=overdrive_user
DB_PASSWORD=tu_password_seguro
DB_NAME=overdrive

# Autenticación JWT
JWT_SECRET=cambia_este_secreto_por_uno_mas_seguro
JWT_EXPIRES_IN=1h

# Usuario admin inicial (genera su hash o pásalo ya hasheado)
# ADMIN_PASSWORD=admin_seguro_123
# ADMIN_PASSWORD_HASH=$2b$12$...

# Servidor
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ============================================================
# Spotify API (Integración OAuth 2.0 - Modo Curador)
# 1. Crea una app gratis en: https://developer.spotify.com/dashboard
# 2. Copia tu Client ID y Client Secret
# 3. En la app de Spotify, en "Edit settings", agrega esta Redirect URI EXACTA:
#    http://127.0.0.1:4000/api/spotify/callback
#    NOTA: Spotify NO acepta 'localhost' desde abril 2025; usa la IP loopback.
# ============================================================
SPOTIFY_CLIENT_ID=tu_client_id_de_spotify
SPOTIFY_CLIENT_SECRET=tu_client_secret_de_spotify
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4000/api/spotify/callback